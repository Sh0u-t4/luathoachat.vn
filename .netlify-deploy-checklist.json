{
  "deployment_checklist": {
    "pre_deployment": [
      {
        "step": "Clear Netlify build cache",
        "status": "pending",
        "critical": true,
        "instructions": "Site Settings → Build & Deploy → Clear cache and retry deploy"
      },
      {
        "step": "Verify Environment Variables",
        "status": "pending",
        "critical": true,
        "required_vars": [
          "NEXT_PUBLIC_SUPABASE_URL",
          "NEXT_PUBLIC_SUPABASE_ANON_KEY"
        ],
        "optional_vars": [
          "NEXT_PUBLIC_GA_MEASUREMENT_ID",
          "NEXT_PUBLIC_GOOGLE_ADS_ID",
          "OPENAI_API_KEY"
        ]
      },
      {
        "step": "Check Node Version",
        "status": "pending",
        "critical": false,
        "recommended": "18.x or higher"
      },
      {
        "step": "Verify package.json build command",
        "status": "completed",
        "critical": true,
        "command": "npm run build"
      }
    ],
    "configuration_files": [
      {
        "file": "netlify.toml",
        "status": "updated",
        "changes": [
          "Added standalone output mode",
          "Updated build command to npm run build",
          "Added functions configuration with esbuild"
        ]
      },
      {
        "file": "next.config.js",
        "status": "updated",
        "changes": [
          "Added output: 'standalone' for Netlify optimization",
          "Added TypeScript and ESLint build checks",
          "Kept existing security headers and caching"
        ]
      }
    ],
    "post_deployment": [
      {
        "test": "Homepage loads successfully",
        "url": "/",
        "expected": "200 OK"
      },
      {
        "test": "API routes work",
        "url": "/api/rate-message",
        "expected": "Proper response or 401"
      },
      {
        "test": "Static assets load",
        "url": "/_next/static/*",
        "expected": "Assets cached properly"
      },
      {
        "test": "Environment variables accessible",
        "check": "process.env.NEXT_PUBLIC_SUPABASE_URL defined in client",
        "expected": "Value present"
      }
    ],
    "troubleshooting": {
      "common_errors": [
        {
          "error": "Module not found",
          "solution": "Clear node_modules and reinstall: rm -rf node_modules package-lock.json && npm install"
        },
        {
          "error": "Build timeout",
          "solution": "Check Netlify plan limits or optimize dependencies"
        },
        {
          "error": "Environment variables undefined",
          "solution": "Ensure NEXT_PUBLIC_ prefix and redeploy after adding vars"
        },
        {
          "error": "Plugin error (@netlify/plugin-nextjs)",
          "solution": "Clear build cache and retry deployment"
        }
      ]
    }
  },
  "deployment_commands": {
    "local_test": "npm run build && npm run start",
    "deploy_via_git": "git add . && git commit -m 'fix: deployment config' && git push",
    "clear_local_cache": "rm -rf .next node_modules package-lock.json && npm install"
  },
  "metadata": {
    "last_updated": "2025-02-24",
    "next_version": "13.5.1",
    "netlify_plugin_version": "5.15.8",
    "node_recommended": "18.x"
  }
}
